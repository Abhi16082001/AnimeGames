---
// Zoomed Image Game - [anime].astro
import Layout from '../../../layouts/Layout.astro';
import gamescategory from '../../../../database/gamescategory.json';
import animecategory from '../../../../database/animecategory.json';
import { filterQuestionsByTrollMode, selectSessionQuestions } from '../../../utils/gameSession';
import { getAnimeProgress, getMiscProgress } from '../../../utils/api';

export async function getStaticPaths() {
  const paths = [];
  for (const anime of animecategory) {
    if (anime.gameCategoryIds.includes('zoomed')) {
      paths.push({ params: { anime: anime.id } });
    }
  }
  paths.push({ params: { anime: 'miscellaneous' } });
  paths.push({ params: { anime: 'daily' } });
  return paths;
}

const { anime } = Astro.params;
const gameId = 'zoomed';
const isDailyChallenge = anime === 'daily';
const isMiscellaneous = anime === 'miscellaneous';
const isMiscellaneousStr = isMiscellaneous ? 'true' : 'false';

const gameConfig = gamescategory.find(g => g.id === gameId);
const questionLimit = gameConfig?.questionLimit ?? 0;

let animeName = isDailyChallenge ? 'Surprise Daily Challenge' : 'Miscellaneous';
let animeBg = 'linear-gradient(135deg, #7C3AED 0%, #EF4444 100%)';

if (!isMiscellaneous && !isDailyChallenge) {
  const animeData = animecategory.find(a => a.id === anime);
  if (animeData) {
    animeName = animeData.name;
    animeBg = animeData.bgimage;
  }
}

// Load the documented static data source at build time.
let allQuestions: any[] = [];
const dailyQuestion = import.meta.glob('../../../../database/zoomed/dailyquestion.json', { eager: true, import: 'default' });
const questionFiles = import.meta.glob('../../../../database/zoomed/*/question.json', { eager: true, import: 'default' });
if (isDailyChallenge) {
  allQuestions = Object.values(dailyQuestion).flatMap((question) => Array.isArray(question) ? question : [question]) as any[];
} else if (isMiscellaneous) {
  allQuestions = Object.entries(questionFiles).flatMap(([path, questions]) => {
    const animeId = path.split('/').at(-2) || '';
    return (questions as any[]).map((question) => ({ ...question, _animeId: animeId }));
  });
} else {
  const questionFile = questionFiles[`../../../../database/zoomed/${anime}/question.json`];
  if (questionFile) allQuestions = questionFile as any[];
}

const filteredQuestions = isDailyChallenge ? allQuestions : filterQuestionsByTrollMode(allQuestions, false);
const selectedSessionQuestions = isDailyChallenge ? allQuestions : selectSessionQuestions(
  filteredQuestions,
  gameId,
  anime,
  questionLimit,
  isMiscellaneous,
  getAnimeProgress,
  getMiscProgress
);

const sessionQuestions = isDailyChallenge ? allQuestions : selectedSessionQuestions.length
  ? selectedSessionQuestions
  : allQuestions.slice(0, questionLimit);
const totalQuestions = sessionQuestions.length;
const hasQuestions = allQuestions.length > 0;
---

<Layout title={`${animeName} - Zoomed Image Game - Anime Realm`}>
  <main class="flex-grow min-h-screen">
    <!-- Game Header -->
    <header class="sticky top-16 z-30 border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 py-3 backdrop-blur-md md:py-4">
          <div class="section-container flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div class="flex min-w-0 items-center gap-3">
          <a href="/games/zoomed" class="p-2 rounded-lg text-[var(--color-text-muted)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:text-[var(--color-text)] hover:bg-[var(--color-bg)] hover:bg-[var(--color-bg)] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)]" aria-label="Back to Zoomed Image Game">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
          </a>
          <div class="min-w-0">
            <h1 class="text-xl md:text-2xl font-black gradient-text">{animeName}</h1>
            <p class="text-sm text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Zoomed Image Game • <span id="session-question-count">{totalQuestions}</span> question<span id="session-question-plural">{totalQuestions !== 1 ? 's' : ''}</span></p>
          </div>
        </div>
        
        <div class="flex items-center gap-3">
          <!-- Progress Indicator -->
          <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--color-bg)] bg-[var(--color-border)] text-sm font-medium text-[var(--color-text-muted)] text-[var(--color-text-muted)]">
            <span id="question-counter">1 / {totalQuestions}</span>
          </div>
        </div>
      </div>
    </header>

    {hasQuestions ? (
      <>
        <!-- Game Area -->
        <section class="py-5 md:py-8" aria-label="Game Area">
          <div class="section-container max-w-3xl min-w-0">
            <!-- Question Card -->
            <article id="question-card" class="card relative overflow-hidden !p-4 sm:!p-6 md:!p-8" data-question-index="0" role="region" aria-label="Question 1 of {totalQuestions}">
              <div class="absolute top-4 right-4 flex gap-2" aria-hidden="true">
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-[var(--color-accent-lavender)] bg-[var(--color-primary)]/20 text-[var(--color-primary)] text-[var(--color-accent-lavender)]">
                  Q<span id="current-q-num">1</span>
                </span>
              </div>
              
              <!-- Zoomed Image View -->
              <div id="zoomed-view" class="relative mx-auto w-full max-w-2xl aspect-[4/3] max-h-[42vh] lg:max-w-[22rem] lg:aspect-square lg:max-h-none rounded-xl overflow-hidden bg-[var(--color-bg)] bg-[var(--color-border)] mb-4" style="background-image: url('{sessionQuestions[0].image}'); background-size: cover; background-position: center;">
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent" aria-hidden="true"></div>
                <div class="absolute bottom-4 left-4 right-4 flex flex-col gap-2">
                  <p class="text-white/90 text-sm font-medium text-center">Who is this character?</p>
                </div>
              </div>
              
              <!-- Answer Input -->
              <div class="space-y-3 mb-4">
                <label for="answer-input" class="block text-sm font-semibold text-[var(--color-text)] text-[var(--color-text)]">
                  Your Answer
                </label>
                <div class="relative">
                  <input
                    type="text"
                    id="answer-input"
                    class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text)] placeholder-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all text-lg pr-24"
                    placeholder="Type the character name..."
                    autocomplete="off"
                    spellcheck="false"
                    aria-describedby="answer-hint"
                  />
                  <button
                    type="button"
                    id="submit-answer"
                    class="absolute right-3 top-1/2 -translate-y-1/2 px-4 py-2 rounded-lg bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-secondary)] text-white font-semibold text-sm hover:from-[var(--color-primary-dark)] hover:to-[var(--color-secondary-dark)] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2"
                    aria-label="Submit answer"
                  >
                    Submit
                  </button>
                </div>
                <p id="answer-hint" class="text-xs text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Press Enter to submit</p>
              </div>
              
              <!-- Feedback -->
              <div id="feedback" class="hidden mb-4 p-4 rounded-lg" role="alert" aria-live="polite"></div>
              
              <!-- Result View (shown after answer) -->
              <div id="result-view" class="hidden">
                <div class="relative aspect-square rounded-xl overflow-hidden bg-[var(--color-bg)] bg-[var(--color-border)] mb-4 hidden" style="background-image: url('{sessionQuestions[0].image}'); background-size: cover; background-position: center;" id="full-image">
                  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent" aria-hidden="true"></div>
                  <p id="correct-name" class="absolute bottom-4 left-4 rounded-lg bg-black/60 px-3 py-2 text-lg font-bold text-white shadow-lg backdrop-blur-sm"></p>
                </div>
                <p id="result-message" class="mb-4 text-center text-sm font-semibold" aria-live="polite"></p>
                <div class="flex justify-center gap-4">
                  <button
                    id="next-question-btn"
                    class="btn-primary"
                    aria-label="Next question"
                  >
                    {isDailyChallenge ? 'See Result' : 'Next Question'}
                  </button>
                </div>
              </div>
            </article>

            <div id="runtime-no-questions" class="hidden card gradient-border text-center" role="status" aria-live="polite">
              <h2 class="text-2xl font-bold text-[var(--color-text)] mb-4">No Questions Available</h2>
              <p class="text-[var(--color-text-muted)] mb-6">No questions match the current Troll Mode. Return to Browse Games to change the global setting, or add matching questions.</p>
              <a href="/games/zoomed" class="btn-secondary">Back to Game Select</a>
            </div>
            
            <!-- Score Summary (shown at end) -->
            <div id="score-summary" class="hidden mt-6 card gradient-border text-center">
              <h2 class="text-2xl font-bold text-[var(--color-text)] text-[var(--color-text)] mb-4">Session Complete!</h2>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
                <div class="p-4 rounded-xl bg-[var(--color-accent-lavender)]/50 bg-[var(--color-primary)]/20">
                  <div class="text-3xl font-bold gradient-text" id="final-correct">0</div>
                  <div class="text-sm text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Correct</div>
                </div>
                <div class="p-4 rounded-xl bg-red-100/50 bg-red-900/20">
                  <div class="text-3xl font-bold text-red-600 text-red-400" id="final-wrong">0</div>
                  <div class="text-sm text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Wrong</div>
                </div>
                <div class="p-4 rounded-xl bg-[var(--color-bg)] bg-[var(--color-border)]">
                  <div class="text-3xl font-bold gradient-text" id="final-percentage">0%</div>
                  <div class="text-sm text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Score</div>
                </div>
              </div>
              <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href={`/games/zoomed/${anime}`} class="btn-secondary">Play Again</a>
                <a href={isDailyChallenge ? '/leaderboard?category=Daily' : '/leaderboard'} class="btn-primary">{isDailyChallenge ? 'View Daily Leaderboard' : 'View Leaderboard'}</a>
              </div>
            </div>
          </div>
        </section>
      </>
    ) : (
      // No questions available
      <section class="py-16 md:py-24">
        <div class="section-container max-w-md mx-auto text-center">
          <div class="card gradient-border !p-6 sm:!p-12">
            <div class="text-6xl mb-4" aria-hidden="true">😔</div>
            <h2 class="text-2xl font-bold text-[var(--color-text)] text-[var(--color-text)] mb-4">No Questions Available</h2>
            <p class="text-[var(--color-text-muted)] text-[var(--color-text-muted)] mb-6">
              No questions are available for {animeName} yet. Try a different anime or add matching questions.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="/games/zoomed" class="btn-secondary">Back to Game Select</a>
            </div>
          </div>
        </div>
      </section>
    )}
  </main>
</Layout>

<script id="game-session-data" type="application/json" set:html={JSON.stringify({ initialQuestions: sessionQuestions, allQuestions, questionLimit, isMiscellaneous: isMiscellaneousStr, isDailyChallenge, gameId, animeId: anime })}></script>

<script>
  import { getClientSessionQuestions, loadCurrentClientQuestions, saveClientSession } from '../../../utils/gameClient';
  import { submitDailyScoreOnce } from '../../../utils/api';
  import { getPrimaryAnswer, isAnswerInList } from '../../../utils/gameSession';

  const sessionData = document.getElementById('game-session-data')?.textContent;
  if (!sessionData) throw new Error('Missing game session data');
  const { initialQuestions, allQuestions, questionLimit, isMiscellaneous, isDailyChallenge, gameId, animeId } = JSON.parse(sessionData);

  // Game state
  let sessionQuestions = initialQuestions;
  let currentQuestionIndex = 0;
  let correctCount = 0;
  let wrongCount = 0;
  let scores: number[] = [];
  let playedQuestionIds: string[] = [];
  let answerSubmitted = false;
  let totalQuestions = sessionQuestions.length;

  // DOM Elements
  const questionCard = document.getElementById('question-card');
  const zoomedView = document.getElementById('zoomed-view');
  const answerInput = document.getElementById('answer-input');
  const submitBtn = document.getElementById('submit-answer');
  const feedback = document.getElementById('feedback');
  const questionCounter = document.getElementById('question-counter');
  const sessionQuestionCount = document.getElementById('session-question-count');
  const sessionQuestionPlural = document.getElementById('session-question-plural');
  const currentQNum = document.getElementById('current-q-num');
  const resultMessage = document.getElementById('result-message');
  const nextQuestionBtn = document.getElementById('next-question-btn');
  const resultView = document.getElementById('result-view');
  const fullImage = document.getElementById('full-image');
  const correctName = document.getElementById('correct-name');
  const scoreSummary = document.getElementById('score-summary');
  const finalCorrect = document.getElementById('final-correct');
  const finalWrong = document.getElementById('final-wrong');
  const finalPercentage = document.getElementById('final-percentage');
  const runtimeNoQuestions = document.getElementById('runtime-no-questions');

  async function applyClientSession(): Promise<boolean> {
    if (isDailyChallenge) return sessionQuestions.length === 1;
    const currentQuestions = await loadCurrentClientQuestions(
      allQuestions,
      gameId,
      animeId,
      isMiscellaneous === 'true',
    );
    sessionQuestions = getClientSessionQuestions(
      currentQuestions,
      gameId,
      animeId,
      questionLimit,
      isMiscellaneous === 'true',
    );
    totalQuestions = sessionQuestions.length;
    if (sessionQuestionCount) sessionQuestionCount.textContent = String(totalQuestions);
    if (sessionQuestionPlural) sessionQuestionPlural.textContent = totalQuestions === 1 ? '' : 's';

    if (!sessionQuestions.length) {
      questionCard?.classList.add('hidden');
      runtimeNoQuestions?.classList.remove('hidden');
      return false;
    }

    questionCard?.classList.remove('hidden');
    runtimeNoQuestions?.classList.add('hidden');
    if (questionCounter) questionCounter.textContent = `1 / ${totalQuestions}`;
    if (currentQNum) currentQNum.textContent = '1';
    return true;
  }

  async function initializeGame() {
    if (!await applyClientSession()) return;

    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    window.scrollTo(0, 0);
    requestAnimationFrame(() => window.scrollTo(0, 0));
    
    // Event listeners
    submitBtn?.addEventListener('click', submitAnswer);
    answerInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        submitAnswer();
      }
    });
    
    nextQuestionBtn?.addEventListener('click', () => {
      if (isDailyChallenge) endGame();
      else nextQuestion();
    });
    
    updateQuestionDisplay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeGame, { once: true });
  } else {
    initializeGame();
  }

  function getCurrentQuestion() {
    return sessionQuestions[currentQuestionIndex];
  }

  function applyZoom(questionIndex: number) {
    const question = sessionQuestions[questionIndex];
    if (!question || !zoomedView) return;
    
    // Get zoom config or use defaults
    const zoom = question.zoom || { scale: 2.5, position: { x: 50, y: 50 } };
    
    // Apply zoom via CSS transform
    zoomedView.style.backgroundSize = `${zoom.scale * 100}%`;
    zoomedView.style.backgroundPosition = `${zoom.position.x}% ${zoom.position.y}%`;
    zoomedView.style.transition = 'background-size 0.8s cubic-bezier(0.4, 0, 0.2, 1), background-position 0.8s cubic-bezier(0.4, 0, 0.2, 1)';
  }

  function zoomOut() {
    if (!zoomedView) return;
    
    // Animate to full image
    zoomedView.style.backgroundSize = '100%';
    zoomedView.style.backgroundPosition = '50% 50%';
    zoomedView.style.transition = 'background-size 1s cubic-bezier(0.4, 0, 0.2, 1), background-position 1s cubic-bezier(0.4, 0, 0.2, 1)';
  }

  function updateQuestionDisplay() {
    const q = getCurrentQuestion();
    if (!q) return;
    
    // Update question counter
    questionCounter.textContent = `${currentQuestionIndex + 1} / ${totalQuestions}`;
    currentQNum.textContent = String(currentQuestionIndex + 1);
    
    // Reset input
    answerInput.value = '';
    answerInput.disabled = false;
    submitBtn.disabled = false;
    feedback.classList.add('hidden');
    feedback.textContent = '';
    feedback.className = 'hidden mb-4 p-4 rounded-lg';
    
    // Hide result view, show zoomed view
    resultView?.classList.add('hidden');
    fullImage?.classList.add('hidden');
    zoomedView?.classList.remove('hidden');
    
    // Apply zoom for this question
    applyZoom(currentQuestionIndex);

    if (zoomedView && q.image) {
      zoomedView.style.backgroundImage = `url('${q.image}')`;
    }
    
    if (fullImage && q.image) {
      fullImage.style.backgroundImage = `url('${q.image}')`;
    }
    if (correctName) correctName.textContent = getPrimaryAnswer(q.answer);
  }

  function submitAnswer() {
    if (answerSubmitted) return;
    
    const answer = answerInput.value.trim();
    if (!answer) return;
    
    const question = getCurrentQuestion();
    const isCorrect = isAnswerInList(answer, question.answer);
    
    answerSubmitted = true;
    answerInput.disabled = true;
    submitBtn.disabled = true;
    
    
    if (isCorrect) {
      // Correct answer
      correctCount++;
      scores.push(1.0);
      if (!isDailyChallenge) playedQuestionIds.push(question.id);
      
      showFeedback(`Amazing! Your guess “${answer}” is right — 1 point!`, 'success');
      resultMessage.textContent = 'Correct · 1 point';
      resultMessage.className = 'mb-4 text-center text-sm font-semibold text-green-300';
      zoomOut();
      fullImage?.classList.remove('hidden');

      // Only correct answers reveal the full image after zooming out.
      setTimeout(() => {
        zoomedView?.classList.add('hidden');
        resultView?.classList.remove('hidden');
      }, 1000);
    } else {
      // Wrong answer
      wrongCount++;
      scores.push(0);
      if (!isDailyChallenge) playedQuestionIds.push(question.id);
      
      showFeedback('Wrong! Score: 0 points.', 'error');
      resultMessage.textContent = 'Wrong · 0 points';
      resultMessage.className = 'mb-4 text-center text-sm font-semibold text-red-300';
      // Incorrect answers keep the existing zoomed-in image visible.
      resultView?.classList.remove('hidden');
    }
    
  }

  function nextQuestion() {
    answerSubmitted = false;
    currentQuestionIndex++;
    
    if (currentQuestionIndex >= totalQuestions) {
      // Game over
      endGame();
    } else {
      // Next question
      updateQuestionDisplay();
    }
  }

  function endGame() {
    questionCard?.classList.add('hidden');
    scoreSummary?.classList.remove('hidden');
    
    const percentage = totalQuestions > 0 ? Math.round((correctCount / totalQuestions) * 100) : 0;
    
    finalCorrect.textContent = String(correctCount);
    finalWrong.textContent = String(wrongCount);
    finalPercentage.textContent = `${percentage}%`;
    
    // Save progress and result
    saveProgressAndResult(percentage);
  }

  function saveProgressAndResult(percentage: number) {
    if (isDailyChallenge) {
      submitDailyScoreOnce(percentage).catch((error) => console.error('Failed to submit Daily Challenge score:', error));
      return;
    }
    const avgScore = scores.length > 0 ? scores.reduce((a, b) => a + b, 0) / scores.length : 0;
    
    saveClientSession(
      gameId,
      animeId,
      isMiscellaneous === 'true',
      playedQuestionIds,
      avgScore,
      percentage,
    ).catch((error) => console.error('Failed to save game session:', error));
  }

  function showFeedback(message: string, type: 'success' | 'error') {
    feedback.textContent = message;
    feedback.className = `mb-4 p-4 rounded-lg ${type === 'success'
      ? 'bg-green-100 bg-green-900/30 text-green-800 text-green-300 border border-green-300 border-green-700'
      : 'bg-red-100 bg-red-900/30 text-red-800 text-red-300 border border-red-300 border-red-700'}`;
    feedback.classList.remove('hidden');
  }
</script>

<style>
  #zoomed-view {
    background-size: 250%;
    background-position: 50% 50%;
    transition: background-size 0.8s cubic-bezier(0.4, 0, 0.2, 1), background-position 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>
