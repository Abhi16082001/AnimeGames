---
import Layout from '../../layouts/Layout.astro';
import gamescategory from '../../../database/gamescategory.json';
import animecategory from '../../../database/animecategory.json';
import TrollModeToggle from '../../components/TrollModeToggle.astro';
import FAQSection from '../../components/FAQSection.astro';
---

<Layout title="Anime Quiz Games | Description, Zoom & Colour Games | Otaku Blitz" description="Choose an Otaku Blitz anime quiz game: clue-based character guessing, zoomed image puzzles, and colour hue matching challenges.">
  <main class="flex-grow">
    <section class="bg-gradient-to-br from-[var(--color-accent-lavender)]/50 to-[var(--color-accent-teal)]/50 py-16 from-[var(--color-primary)]/10 to-[var(--color-secondary)]/10 md:py-24">
      <div class="section-container text-center">
        <h1 class="mb-6 text-4xl font-black tracking-tight gradient-text md:text-5xl lg:text-6xl">Anime Quiz Games</h1>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-[var(--color-text-muted)] text-[var(--color-text-muted)] md:text-xl">
          Choose a game mode, pick an anime, and test your character knowledge.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3" aria-label="Troll Mode settings">
          <span class="text-sm font-semibold text-[var(--color-text-muted)]">Global setting:</span>
          <TrollModeToggle />
        </div>
      </div>
    </section>

    <section class="py-12 md:py-20">
      <div class="section-container">
        <div class="mx-auto max-w-5xl space-y-4">
          {gamescategory.filter((game) => game.show).map((game) => {
            const supportedAnime = animecategory.filter((anime) => anime.gameCategoryIds.includes(game.id));
            const description = game.id === 'description'
              ? 'Guess characters from progressive clues.'
              : game.id === 'zoomed'
                ? 'Identify characters from zoomed-in images.'
                : 'Match the colour of anime images.';

            return (
              <details class="group overflow-hidden rounded-2xl border-2 border-[var(--color-border)] bg-cover bg-center shadow-sm open:border-[var(--color-primary)] open:shadow-lg" style="background-image: url('/sample.png');">
                <summary class="relative isolate flex cursor-pointer list-none items-center gap-4 px-5 py-5 [&>*]:relative [&::-webkit-details-marker]:hidden before:absolute before:inset-0 before:-z-10 before:bg-blue-950/65 md:px-7 md:py-6">
                  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[var(--color-accent-lavender)] text-2xl" aria-hidden="true">
                    {game.id === 'description' ? '📝' : game.id === 'zoomed' ? '🔍' : '🎨'}
                  </span>
                  <span class="min-w-0 flex-1">
                     <span class="block text-xl font-bold text-[var(--color-text)] md:text-2xl">{game.name}</span>
                     <span class="mt-1 block text-sm leading-relaxed text-[var(--color-text-muted)] md:text-base">{description}</span>
                  </span>
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-gray-300 text-2xl text-[var(--color-primary)] transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>

                 <div class="border-t border-[var(--color-border)] bg-[var(--color-bg)] px-5 py-6 md:px-7 md:py-8">
                  <div class="mb-5 flex items-center justify-between gap-4">
                     <h2 class="text-sm font-bold uppercase tracking-[0.16em] text-[var(--color-text-muted)]">Choose an anime</h2>
                     <span class="text-sm text-[var(--color-text-muted)]">{supportedAnime.length} available</span>
                  </div>
                  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {supportedAnime.map((anime) => (
                      <a href={`/games/${game.id}/${anime.id}`} class="group/anime relative flex aspect-square min-h-48 flex-col justify-end overflow-hidden rounded-xl border border-white/40 bg-cover bg-center p-5 shadow-sm transition-transform hover:-translate-y-1 hover:shadow-lg" style="background-image: url('/sample.png');">
                        <span class="absolute inset-0 bg-blue-950/60 transition-colors group-hover/anime:bg-blue-950/45" aria-hidden="true"></span>
                        <span class="relative text-xl font-bold text-white drop-shadow-md">{anime.name}</span>
                        <span class="relative mt-1 text-sm font-medium text-white/85">Play {game.name}</span>
                      </a>
                    ))}
                    <a href={`/games/${game.id}/miscellaneous`} class="group/anime relative flex aspect-square min-h-48 flex-col justify-end overflow-hidden rounded-xl bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-secondary)] p-5 shadow-sm transition-transform hover:-translate-y-1 hover:shadow-lg">
                      <span class="text-4xl" aria-hidden="true">🎲</span>
                      <span class="mt-4 text-xl font-bold text-white">Miscellaneous</span>
                      <span class="mt-1 text-sm font-medium text-white/85">Mix every supported anime</span>
                    </a>
                  </div>
                </div>
              </details>
            );
          })}
        </div>
      </div>
    </section>

    <section class="bg-[var(--color-bg)] py-12 bg-[var(--color-bg)] md:py-20">
      <div class="section-container">
        <div class="mb-12 text-center md:mb-16">
          <h2 class="section-title mb-4">How It Works</h2>
          <p class="section-subtitle">Choose a mode, pick an anime, and start your challenge.</p>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
          {[
            { step: 1, title: 'Open a Game', desc: 'Expand a game category to see its available anime.' },
            { step: 2, title: 'Pick an Anime', desc: 'Choose a square anime card to launch that challenge.' },
            { step: 3, title: 'Play & Score', desc: 'Answer questions, track progress, and climb the leaderboard.' }
          ].map((step) => (
            <article class="card relative text-center">
              <div class="absolute -top-4 left-1/2 flex h-12 w-12 -translate-x-1/2 items-center justify-center rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-secondary)] text-xl font-bold text-white" aria-hidden="true">{step.step}</div>
              <div class="pt-10">
                <h3 class="mb-3 text-xl font-bold text-[var(--color-text)] text-[var(--color-text)]">{step.title}</h3>
                <p class="leading-relaxed text-[var(--color-text-muted)] text-[var(--color-text-muted)]">{step.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-12 md:py-16" aria-labelledby="anime-game-guide-title">
      <div class="section-container max-w-4xl">
        <h2 id="anime-game-guide-title" class="section-title mb-5">Choose Your Anime Guessing Game</h2>
        <div class="space-y-4 leading-relaxed text-[var(--color-text-muted)]">
          <p>The Description Game is a hint game for players who like to reason from progressive clues: answer early to earn more points. The Zoomed Image Game, also known as a zoom game, asks you to guess the anime character from a close-up before more of the image is revealed. Both are quick quiz game formats built around visual memory and anime knowledge.</p>
          <p>For a different challenge, explore our colour games. The Colour Guessing Game is a colour hue game where you adjust hue, saturation, and brightness to match the image. It is a colour guessing game that rewards careful observation rather than a single typed answer. Choose Naruto, Bleach, One Piece, or Pokémon where available, or select Miscellaneous to mix supported series in one session.</p>
          <p>Each mode is a practical way to test your anime IQ. Pick a category below, then select the series you know best to begin.</p>
        </div>
      </div>
    </section>

    <FAQSection
      title="Games FAQ"
      subtitle="Quick answers before you choose a challenge."
      faqs={[
        { q: 'Which game should I start with?', a: 'Description is great for clue-based guessing, Zoom tests visual recognition, and Colour challenges your colour matching skills.' },
        { q: 'What does Miscellaneous do?', a: 'It mixes questions from every anime supported by the selected game mode into one shuffled session.' },
        { q: 'Can I change Troll Mode later?', a: 'Yes. The toggle at the top of this page changes the setting for every game and saves your preference.' },
        { q: 'Where do my best scores appear?', a: 'Improved scores are saved after a completed session and can appear on the global leaderboard.' },
      ]}
    />
  </main>
</Layout>

