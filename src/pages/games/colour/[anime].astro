---
// Colour Guessing Game - [anime].astro
import Layout from '../../../layouts/Layout.astro';
import gamescategory from '../../../database/gamescategory.json';
import animecategory from '../../../database/animecategory.json';
import { loadQuestions, filterQuestionsByTrollMode, getQuestionLimit, getTrollMode, selectSessionQuestions } from '../../../utils/gameSession';
import { getAnimeProgress, getMiscProgress, saveAnimeProgress, saveMiscProgress, clearAnimeProgress, clearMiscProgress, saveGameResult } from '../../../utils/api';

export async function getStaticPaths() {
  const paths = [];
  for (const anime of animecategory) {
    if (anime.gameCategoryIds.includes('colour')) {
      paths.push({ params: { anime: anime.id } });
    }
  }
  paths.push({ params: { anime: 'miscellaneous' } });
  return paths;
}

const { anime } = Astro.params;
const gameId = 'colour';
const isMiscellaneous = anime === 'miscellaneous';
const isMiscellaneousStr = isMiscellaneous ? 'true' : 'false';

const gameConfig = gamescategory.find(g => g.id === gameId);
const questionLimit = gameConfig?.questionLimit || 3;

let animeName = 'Miscellaneous';
let animeBg = 'linear-gradient(135deg, #7C3AED 0%, #EF4444 100%)';

if (!isMiscellaneous) {
  const animeData = animecategory.find(a => a.id === anime);
  if (animeData) {
    animeName = animeData.name;
    animeBg = animeData.bgimage;
  }
}

const trollMode = getTrollMode(gameId);

// Load questions at build time for static generation
let allQuestions: any[] = [];
if (!isMiscellaneous) {
  const questionFiles = import.meta.glob('../../../database/colour/*/question.json', { eager: true, import: 'default' });
  const questionFile = questionFiles[`../../../database/colour/${anime}/question.json`];
  if (questionFile) allQuestions = questionFile as any[];
}

const filteredQuestions = filterQuestionsByTrollMode(allQuestions, trollMode);
const sessionQuestions = selectSessionQuestions(
  filteredQuestions,
  gameId,
  anime,
  questionLimit,
  isMiscellaneous,
  getAnimeProgress,
  getMiscProgress
);

const totalQuestions = sessionQuestions.length;
const hasQuestions = totalQuestions > 0;
---

<Layout title={`${animeName} - Colour Guessing Game - Anime Realm`}>
  <main class="flex-grow min-h-screen">
    <!-- Game Header -->
    <header class="sticky top-16 z-30 bg-white/80 bg-[var(--color-bg)]/80 backdrop-blur-md border-b border-[var(--color-border)] border-[var(--color-border)] px-4 py-4 md:px-6">
      <div class="section-container flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-3">
          <a href="/games/colour" class="p-2 rounded-lg text-[var(--color-text-muted)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:text-[var(--color-text)] hover:bg-[var(--color-bg)] hover:bg-[var(--color-bg)] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)]" aria-label="Back to Colour Guessing Game">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
          </a>
          <div>
            <h1 class="text-xl md:text-2xl font-black gradient-text">{animeName}</h1>
            <p class="text-sm text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Colour Guessing Game • {totalQuestions} question{totalQuestions !== 1 ? 's' : ''}</p>
          </div>
        </div>
        
        <div class="flex items-center gap-3">
          <!-- Progress Indicator -->
          <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--color-bg)] bg-[var(--color-border)] text-sm font-medium text-[var(--color-text-muted)] text-[var(--color-text-muted)]">
            <span id="question-counter">1 / {totalQuestions}</span>
          </div>
        </div>
      </div>
    </header>

    {hasQuestions ? (
      <>
        <!-- Game Area -->
        <section class="py-8 md:py-12 px-4 md:px-6" aria-label="Game Area">
          <div class="section-container max-w-3xl">
            <!-- Question Card -->
            <article id="question-card" class="card relative overflow-hidden" data-question-index="0" role="region" aria-label="Question 1 of {totalQuestions}">
              <div class="absolute top-4 right-4 flex gap-2" aria-hidden="true">
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-[var(--color-accent-lavender)] bg-[var(--color-primary)]/20 text-[var(--color-primary)] text-[var(--color-accent-lavender)]">
                  Q<span id="current-q-num">1</span>
                </span>
              </div>
              
              <!-- Transparent Image with Color Background -->
              <div class="relative mb-6">
                <div 
                  id="color-display" 
                  class="relative aspect-square rounded-xl overflow-hidden bg-[var(--color-bg)] bg-[var(--color-border)]"
                  style="background-color: hsl(0, 100%, 50%);"
                  role="img"
                  aria-label="Color matching area - transparent anime image will show through this color"
                >
                  <!-- Transparent anime image overlay -->
                  <img 
                    id="transparent-image" 
                    src="{sessionQuestions[0].image}" 
                    alt="" 
                    class="absolute inset-0 w-full h-full object-cover opacity-90"
                    aria-hidden="true"
                  />
                  <!-- Color indicator -->
                  <div class="absolute bottom-4 left-4 right-4">
                    <div class="flex items-center justify-center gap-3">
                      <div id="current-color-swatch" class="w-10 h-10 rounded-full border-2 border-white/50 shadow-lg" style="background-color: hsl(0, 100%, 50%);" aria-hidden="true"></div>
                      <span id="current-color-value" class="text-white/90 text-sm font-mono font-semibold px-3 py-1 rounded bg-black/50">HSL(0, 100%, 50%)</span>
                    </div>
                  </div>
                </div>
              </div>
              
              <!-- Color Controls -->
              <div class="space-y-6 mb-6" role="group" aria-label="Color controls">
                <!-- Hue Picker (Circular) -->
                <div>
                  <label for="hue-picker" class="block text-sm font-semibold text-[var(--color-text)] text-[var(--color-text)] mb-3 flex items-center gap-2">
                    <span class="w-4 h-4 rounded-full" style="background: linear-gradient(90deg, red, yellow, lime, cyan, blue, magenta, red);" aria-hidden="true"></span>
                    Hue
                    <span id="hue-value" class="text-sm font-mono text-[var(--color-text-muted)] text-[var(--color-text-muted)]">0°</span>
                  </label>
                  <div class="relative">
                    <input
                      type="range"
                      id="hue-picker"
                      min="0"
                      max="360"
                      value="0"
                      class="w-full h-2 appearance-none bg-transparent cursor-pointer"
                      aria-label="Hue slider"
                      aria-valuemin="0"
                      aria-valuemax="360"
                      aria-valuenow="0"
                    />
                    <!-- Gradient track visual -->
                    <div class="absolute inset-0 h-2 rounded-full pointer-events-none" style="background: linear-gradient(90deg, red, yellow, lime, cyan, blue, magenta, red);" aria-hidden="true"></div>
                    <div id="hue-thumb" class="absolute top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-white border-2 border-[var(--color-primary)] shadow-lg pointer-events-none transition-transform duration-100" style="left: 0%; transform: translate(-50%, -50%);" aria-hidden="true"></div>
                  </div>
                </div>
                
                <!-- Saturation Slider -->
                <div>
                  <label for="saturation-slider" class="block text-sm font-semibold text-[var(--color-text)] text-[var(--color-text)] mb-3 flex items-center gap-2">
                    <span class="w-4 h-4 rounded" style="background: linear-gradient(90deg, hsl(0, 0%, 50%), hsl(0, 100%, 50%));" aria-hidden="true"></span>
                    Saturation
                    <span id="saturation-value" class="text-sm font-mono text-[var(--color-text-muted)] text-[var(--color-text-muted)]">100%</span>
                  </label>
                  <div class="relative">
                    <input
                      type="range"
                      id="saturation-slider"
                      min="0"
                      max="100"
                      value="100"
                      class="w-full h-2 appearance-none bg-transparent cursor-pointer"
                      aria-label="Saturation slider"
                      aria-valuemin="0"
                      aria-valuemax="100"
                      aria-valuenow="100"
                    />
                    <div id="saturation-track" class="absolute inset-0 h-2 rounded-full pointer-events-none" style="background: linear-gradient(90deg, hsl(0, 0%, 50%), hsl(0, 100%, 50%));" aria-hidden="true"></div>
                    <div id="saturation-thumb" class="absolute top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-white border-2 border-[var(--color-secondary)] shadow-lg pointer-events-none transition-transform duration-100" style="left: 100%; transform: translate(-50%, -50%);" aria-hidden="true"></div>
                  </div>
                </div>
                
                <!-- Brightness Slider -->
                <div>
                  <label for="brightness-slider" class="block text-sm font-semibold text-[var(--color-text)] text-[var(--color-text)] mb-3 flex items-center gap-2">
                    <span class="w-4 h-4 rounded" style="background: linear-gradient(90deg, black, white);" aria-hidden="true"></span>
                    Brightness
                    <span id="brightness-value" class="text-sm font-mono text-[var(--color-text-muted)] text-[var(--color-text-muted)]">50%</span>
                  </label>
                  <div class="relative">
                    <input
                      type="range"
                      id="brightness-slider"
                      min="0"
                      max="100"
                      value="50"
                      class="w-full h-2 appearance-none bg-transparent cursor-pointer"
                      aria-label="Brightness slider"
                      aria-valuemin="0"
                      aria-valuemax="100"
                      aria-valuenow="50"
                    />
                    <div class="absolute inset-0 h-2 rounded-full pointer-events-none bg-gradient-to-r from-black to-white" aria-hidden="true"></div>
                    <div id="brightness-thumb" class="absolute top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-white border-2 border-[var(--color-primary)] shadow-lg pointer-events-none transition-transform duration-100" style="left: 50%; transform: translate(-50%, -50%);" aria-hidden="true"></div>
                  </div>
                </div>
              </div>
              
              <!-- Submit Button -->
              <div class="mb-6">
                <button
                  type="button"
                  id="submit-answer"
                  class="btn-primary w-full"
                  aria-label="Submit color match"
                >
                  Submit Match
                </button>
              </div>
              
              <!-- Feedback -->
              <div id="feedback" class="hidden mb-4 p-4 rounded-lg" role="alert" aria-live="polite"></div>
              
              <!-- Result View (shown after answer) -->
              <div id="result-view" class="hidden">
                <div class="relative aspect-square rounded-xl overflow-hidden bg-[var(--color-bg)] bg-[var(--color-border)] mb-4">
                  <!-- Player's result -->
                  <div id="player-result" class="absolute inset-0" style="background-color: hsl(0, 100%, 50%);">
                    <img 
                      src="{sessionQuestions[0].image}" 
                      alt="" 
                      class="absolute inset-0 w-full h-full object-cover opacity-90"
                      aria-hidden="true"
                    />
                  </div>
                  <!-- Correct image overlay -->
                  <div id="correct-overlay" class="absolute inset-0 hidden">
                    <img 
                      id="correct-image" 
                      src="{sessionQuestions[0].correctImage || sessionQuestions[0].image}" 
                      alt="Correct color reference" 
                      class="absolute inset-0 w-full h-full object-cover"
                    />
                  </div>
                  <div class="absolute bottom-4 left-4 right-4">
                    <h3 class="text-2xl font-bold text-white drop-shadow-lg" id="revealed-name">{sessionQuestions[0].answer}</h3>
                    <p class="text-white/80 text-sm" id="match-percentage">Match: 0%</p>
                  </div>
                </div>
                
                <!-- Comparison instruction -->
                <p class="text-center text-sm text-[var(--color-text-muted)] text-[var(--color-text-muted)] mb-4">
                  Hold / hover on the image to compare with correct answer
                </p>
                
                <div class="flex justify-center gap-4">
                  <button
                    id="next-question-btn"
                    class="btn-primary"
                    aria-label="Next question"
                  >
                    Next Question
                  </button>
                </div>
              </div>
            </article>
            
            <!-- Score Summary (shown at end) -->
            <div id="score-summary" class="hidden mt-6 card gradient-border text-center">
              <h2 class="text-2xl font-bold text-[var(--color-text)] text-[var(--color-text)] mb-4">Session Complete!</h2>
              <div class="grid grid-cols-3 gap-4 mb-6">
                <div class="p-4 rounded-xl bg-[var(--color-accent-lavender)]/50 bg-[var(--color-primary)]/20">
                  <div class="text-3xl font-bold gradient-text" id="final-correct">0</div>
                  <div class="text-sm text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Correct</div>
                </div>
                <div class="p-4 rounded-xl bg-red-100/50 bg-red-900/20">
                  <div class="text-3xl font-bold text-red-600 text-red-400" id="final-wrong">0</div>
                  <div class="text-sm text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Wrong</div>
                </div>
                <div class="p-4 rounded-xl bg-[var(--color-bg)] bg-[var(--color-border)]">
                  <div class="text-3xl font-bold gradient-text" id="final-percentage">0%</div>
                  <div class="text-sm text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Avg Match</div>
                </div>
              </div>
              <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href={`/games/colour/${anime}`} class="btn-secondary">Play Again</a>
                <a href="/leaderboard" class="btn-primary">View Leaderboard</a>
              </div>
            </div>
          </div>
        </section>
      </>
    ) : (
      // No questions available
      <section class="py-16 md:py-24 px-4 md:px-6">
        <div class="section-container max-w-md mx-auto text-center">
          <div class="card gradient-border p-12">
            <div class="text-6xl mb-4" aria-hidden="true">😔</div>
            <h2 class="text-2xl font-bold text-[var(--color-text)] text-[var(--color-text)] mb-4">No Questions Available</h2>
            <p class="text-[var(--color-text-muted)] text-[var(--color-text-muted)] mb-6">
              {trollMode 
                ? `No troll questions found for ${animeName}. Try turning off Troll Mode!`
                : `No regular questions found for ${animeName}.`}
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="/games/colour" class="btn-secondary">Back to Game Select</a>
            </div>
          </div>
        </div>
      </section>
    )}
  </main>
</Layout>

<script define:vars={{ sessionQuestions, questionLimit, isMiscellaneous: isMiscellaneousStr, gameId, animeId: anime }}>
  // Game state
  let currentQuestionIndex = 0;
  let correctCount = 0;
  let wrongCount = 0;
  let matchPercentages: number[] = [];
  let playedQuestionIds: string[] = [];
  let answerSubmitted = false;
  let isComparing = false;
  const totalQuestions = sessionQuestions.length;

  // Color state
  let currentHue = 0;
  let currentSaturation = 100;
  let currentBrightness = 50;

  // DOM Elements
  const questionCard = document.getElementById('question-card');
  const colorDisplay = document.getElementById('color-display');
  const transparentImage = document.getElementById('transparent-image');
  const currentColorSwatch = document.getElementById('current-color-swatch');
  const currentColorValue = document.getElementById('current-color-value');
  const huePicker = document.getElementById('hue-picker');
  const saturationSlider = document.getElementById('saturation-slider');
  const brightnessSlider = document.getElementById('brightness-slider');
  const hueThumb = document.getElementById('hue-thumb');
  const saturationThumb = document.getElementById('saturation-thumb');
  const brightnessThumb = document.getElementById('brightness-thumb');
  const saturationTrack = document.getElementById('saturation-track');
  const hueValue = document.getElementById('hue-value');
  const saturationValue = document.getElementById('saturation-value');
  const brightnessValue = document.getElementById('brightness-value');
  const submitBtn = document.getElementById('submit-answer');
  const feedback = document.getElementById('feedback');
  const questionCounter = document.getElementById('question-counter');
  const currentQNum = document.getElementById('current-q-num');
  const revealedName = document.getElementById('revealed-name');
  const matchPercentage = document.getElementById('match-percentage');
  const nextQuestionBtn = document.getElementById('next-question-btn');
  const resultView = document.getElementById('result-view');
  const playerResult = document.getElementById('player-result');
  const correctOverlay = document.getElementById('correct-overlay');
  const correctImage = document.getElementById('correct-image');
  const scoreSummary = document.getElementById('score-summary');
  const finalCorrect = document.getElementById('final-correct');
  const finalWrong = document.getElementById('final-wrong');
  const finalPercentage = document.getElementById('final-percentage');

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    if (!sessionQuestions.length) return;
    
    // Initialize color from first question's correct answer or defaults
    const firstQuestion = sessionQuestions[0];
    if (firstQuestion.color) {
      currentHue = hexToHue(firstQuestion.color.hex);
      currentSaturation = firstQuestion.color.saturation;
      currentBrightness = firstQuestion.color.brightness;
    }
    
    updateColorDisplay();
    setupSliders();
    setupComparison();
    
    // Event listeners
    submitBtn?.addEventListener('click', submitAnswer);
    nextQuestionBtn?.addEventListener('click', nextQuestion);
  });

  function setupSliders() {
    // Hue picker
    huePicker?.addEventListener('input', (e) => {
      currentHue = parseInt((e.target as HTMLInputElement).value);
      updateColorDisplay();
      updateHueThumb();
    });
    
    // Saturation slider
    saturationSlider?.addEventListener('input', (e) => {
      currentSaturation = parseInt((e.target as HTMLInputElement).value);
      updateColorDisplay();
      updateSaturationThumb();
      updateSaturationTrack();
    });
    
    // Brightness slider
    brightnessSlider?.addEventListener('input', (e) => {
      currentBrightness = parseInt((e.target as HTMLInputElement).value);
      updateColorDisplay();
      updateBrightnessThumb();
    });
    
    // Keyboard support for sliders
    [huePicker, saturationSlider, brightnessSlider].forEach(slider => {
      slider?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
          e.preventDefault();
          slider.stepDown();
          slider.dispatchEvent(new Event('input'));
        } else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
          e.preventDefault();
          slider.stepUp();
          slider.dispatchEvent(new Event('input'));
        }
      });
    });
  }

  function updateColorDisplay() {
    const hslColor = `hsl(${currentHue}, ${currentSaturation}%, ${currentBrightness}%)`;
    
    // Update color display background
    if (colorDisplay) colorDisplay.style.backgroundColor = hslColor;
    if (currentColorSwatch) currentColorSwatch.style.backgroundColor = hslColor;
    if (currentColorValue) currentColorValue.textContent = `HSL(${currentHue}, ${currentSat}%, ${currentBrightness}%)`;
    if (playerResult) playerResult.style.backgroundColor = hslColor;
    
    // Update saturation track gradient
    updateSaturationTrack();
    
    // Update slider values
    if (hueValue) hueValue.textContent = `${currentHue}°`;
    if (saturationValue) saturationValue.textContent = `${currentSaturation}%`;
    if (brightnessValue) brightnessValue.textContent = `${currentBrightness}%`;
    
    // Update thumb positions
    updateHueThumb();
    updateSaturationThumb();
    updateBrightnessThumb();
    
    // Update slider aria-valuenow
    if (huePicker) huePicker.setAttribute('aria-valuenow', String(currentHue));
    if (saturationSlider) saturationSlider.setAttribute('aria-valuenow', String(currentSaturation));
    if (brightnessSlider) brightnessSlider.setAttribute('aria-valuenow', String(currentBrightness));
  }

  function updateHueThumb() {
    if (hueThumb) {
      const percent = (currentHue / 360) * 100;
      hueThumb.style.left = `${percent}%`;
    }
  }

  function updateSaturationThumb() {
    if (saturationThumb) {
      const percent = currentSaturation;
      saturationThumb.style.left = `${percent}%`;
    }
  }

  function updateBrightnessThumb() {
    if (brightnessThumb) {
      const percent = currentBrightness;
      brightnessThumb.style.left = `${percent}%`;
    }
  }

  function updateSaturationTrack() {
    if (saturationTrack) {
      saturationTrack.style.background = `linear-gradient(90deg, hsl(${currentHue}, 0%, ${currentBrightness}%), hsl(${currentHue}, 100%, ${currentBrightness}%))`;
    }
  }

  function setupComparison() {
    const resultImageContainer = document.querySelector('#result-view .relative.aspect-square');
    if (!resultImageContainer) return;
    
    // Mouse events
    resultImageContainer.addEventListener('mouseenter', () => showCorrectImage());
    resultImageContainer.addEventListener('mouseleave', () => hideCorrectImage());
    
    // Touch events
    resultImageContainer.addEventListener('touchstart', (e) => {
      e.preventDefault();
      showCorrectImage();
    }, { passive: false });
    resultImageContainer.addEventListener('touchend', () => hideCorrectImage());
    resultImageContainer.addEventListener('touchcancel', () => hideCorrectImage());
  }

  function showCorrectImage() {
    isComparing = true;
    correctOverlay?.classList.remove('hidden');
  }

  function hideCorrectImage() {
    isComparing = false;
    correctOverlay?.classList.add('hidden');
  }

  function getCurrentQuestion() {
    return sessionQuestions[currentQuestionIndex];
  }

  function updateQuestionDisplay() {
    const q = getCurrentQuestion();
    if (!q) return;
    
    // Update question counter
    questionCounter.textContent = `${currentQuestionIndex + 1} / ${totalQuestions}`;
    currentQNum.textContent = String(currentQuestionIndex + 1);
    
    // Reset color to defaults or question's correct answer
    if (q.color) {
      currentHue = hexToHue(q.color.hex);
      currentSaturation = q.color.saturation;
      currentBrightness = q.color.brightness;
    } else {
      currentHue = 0;
      currentSaturation = 100;
      currentBrightness = 50;
    }
    
    // Update sliders
    if (huePicker) huePicker.value = String(currentHue);
    if (saturationSlider) saturationSlider.value = String(currentSaturation);
    if (brightnessSlider) brightnessSlider.value = String(currentBrightness);
    
    // Update transparent image
    if (transparentImage && q.image) {
      transparentImage.src = q.image;
    }
    
    // Update correct image for comparison
    if (correctImage) {
      correctImage.src = q.correctImage || q.image;
    }
    
    // Update revealed name
    if (revealedName) revealedName.textContent = q.answer;
    
    // Reset UI
    updateColorDisplay();
    answerSubmitted = false;
    submitBtn.disabled = false;
    feedback.classList.add('hidden');
    feedback.textContent = '';
    feedback.className = 'hidden mb-4 p-4 rounded-lg';
    resultView?.classList.add('hidden');
    correctOverlay?.classList.add('hidden');
  }

  function submitAnswer() {
    if (answerSubmitted) return;
    
    const question = getCurrentQuestion();
    if (!question.color) return;
    
    answerSubmitted = true;
    submitBtn.disabled = true;
    
    // Calculate match percentage
    const matchPct = calculateColorMatch(
      currentHue, currentSaturation, currentBrightness,
      hexToHue(question.color.hex), question.color.saturation, question.color.brightness
    );
    
    matchPercentages.push(matchPct);
    playedQuestionIds.push(question.id);
    
    const score = matchPct / 100;
    
    if (matchPct >= 90) {
      correctCount++;
      showFeedback(`Excellent match! ${matchPct}%`, 'success');
    } else if (matchPct >= 50) {
      correctCount++; // Count as correct for scoring purposes
      showFeedback(`Good match! ${matchPct}%`, 'success');
    } else {
      wrongCount++;
      showFeedback(`Match: ${matchPct}%`, 'error');
    }
    
    // Show result view
    if (matchPercentage) matchPercentage.textContent = `Match: ${matchPct}%`;
    resultView?.classList.remove('hidden');
    
    // Setup comparison for this result
    setupComparison();
  }

  function calculateColorMatch(h1: number, s1: number, b1: number, h2: number, s2: number, b2: number): number {
    // Calculate hue difference (circular)
    let hueDiff = Math.abs(h1 - h2);
    hueDiff = Math.min(hueDiff, 360 - hueDiff);
    const hueScore = 1 - (hueDiff / 180); // 0-1
    
    const satScore = 1 - (Math.abs(s1 - s2) / 100);
    const briScore = 1 - (Math.abs(b1 - b2) / 100);
    
    // Weighted average: hue 50%, saturation 25%, brightness 25%
    const totalScore = (hueScore * 0.5) + (satScore * 0.25) + (briScore * 0.25);
    return Math.round(Math.max(0, Math.min(100, totalScore * 100)));
  }

  function hexToHue(hex: string): number {
    const r = parseInt(hex.slice(1, 3), 16) / 255;
    const g = parseInt(hex.slice(3, 5), 16) / 255;
    const b = parseInt(hex.slice(5, 7), 16) / 255;
    
    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    const delta = max - min;
    
    if (delta === 0) return 0;
    
    let hue = 0;
    if (max === r) hue = ((g - b) / delta) % 6;
    else if (max === g) hue = (b - r) / delta + 2;
    else hue = (r - g) / delta + 4;
    
    hue = Math.round(hue * 60);
    if (hue < 0) hue += 360;
    return hue;
  }

  function nextQuestion() {
    currentQuestionIndex++;
    
    if (currentQuestionIndex >= totalQuestions) {
      // Game over
      endGame();
    } else {
      // Next question
      updateQuestionDisplay();
    }
  }

  function endGame() {
    questionCard?.classList.add('hidden');
    scoreSummary?.classList.remove('hidden');
    
    const avgMatch = matchPercentages.length > 0 
      ? Math.round(matchPercentages.reduce((a, b) => a + b, 0) / matchPercentages.length)
      : 0;
    const percentage = totalQuestions > 0 ? Math.round((correctCount / totalQuestions) * 100) : 0;
    
    finalCorrect.textContent = String(correctCount);
    finalWrong.textContent = String(wrongCount);
    finalPercentage.textContent = `${avgMatch}%`;
    
    // Save progress and result
    saveProgressAndResult(avgMatch / 100);
  }

  function saveProgressAndResult(avgScore: number) {
    const avgMatchPct = matchPercentages.length > 0 
      ? Math.round(matchPercentages.reduce((a, b) => a + b, 0) / matchPercentages.length)
      : 0;
    
    // Save to localStorage via api
    if (typeof saveGameResult === 'function') {
      saveGameResult(gameId, animeId, avgScore, avgMatchPct);
    }
    
    // Save progress
    if (isMiscellaneous === 'true') {
      if (typeof saveMiscProgress === 'function') {
        saveMiscProgress(gameId, playedQuestionIds);
      }
    } else {
      if (playedQuestionIds.length > 0 && typeof saveAnimeProgress === 'function') {
        const lastPlayedId = playedQuestionIds[playedQuestionIds.length - 1];
        const lastIndex = sessionQuestions.findIndex(q => q.id === lastPlayedId);
        if (lastIndex === sessionQuestions.length - 1) {
          if (typeof clearAnimeProgress === 'function') clearAnimeProgress(gameId, animeId);
        } else {
          saveAnimeProgress(gameId, animeId, lastPlayedId);
        }
      }
    }
  }

  function showFeedback(message: string, type: 'success' | 'error') {
    feedback.textContent = message;
    feedback.className = `mb-4 p-4 rounded-lg ${type === 'success' 
      ? 'bg-green-100 bg-green-900/30 text-green-800 text-green-300 border border-green-300 border-green-700' 
      : 'bg-red-100 bg-red-900/30 text-red-800 text-red-300 border border-red-300 border-red-700'}`;
    feedback.classList.remove('hidden');
  }
</script>

