---
// Description Game - [anime].astro
import Layout from '../../../layouts/Layout.astro';
import gamescategory from '../../../../database/gamescategory.json';
import animecategory from '../../../../database/animecategory.json';
import { filterQuestionsByTrollMode, selectSessionQuestions } from '../../../utils/gameSession';
import { getAnimeProgress, getMiscProgress } from '../../../utils/api';

export async function getStaticPaths() {
  const paths = [];
  for (const anime of animecategory) {
    if (anime.gameCategoryIds.includes('description')) {
      paths.push({ params: { anime: anime.id } });
    }
  }
  paths.push({ params: { anime: 'miscellaneous' } });
  return paths;
}

const { anime } = Astro.params;
const gameId = 'description';
const isMiscellaneous = anime === 'miscellaneous';
const isMiscellaneousStr = isMiscellaneous ? 'true' : 'false';

const gameConfig = gamescategory.find(g => g.id === gameId);
const questionLimit = gameConfig?.questionLimit ?? 0;

let animeName = 'Miscellaneous';
let animeBg = 'linear-gradient(135deg, #7C3AED 0%, #EF4444 100%)';

if (!isMiscellaneous) {
  const animeData = animecategory.find(a => a.id === anime);
  if (animeData) {
    animeName = animeData.name;
    animeBg = animeData.bgimage;
  }
}

// Load the documented static data source at build time.
let allQuestions: any[] = [];
const questionFiles = import.meta.glob('../../../../database/description/*/question.json', { eager: true, import: 'default' });
if (isMiscellaneous) {
  allQuestions = Object.entries(questionFiles).flatMap(([path, questions]) => {
    const animeId = path.split('/').at(-2) || '';
    return (questions as any[]).map((question) => ({ ...question, _animeId: animeId }));
  });
} else {
  const questionFile = questionFiles[`../../../../database/description/${anime}/question.json`];
  if (questionFile) allQuestions = questionFile as any[];
}

const filteredQuestions = filterQuestionsByTrollMode(allQuestions, false);
const selectedSessionQuestions = selectSessionQuestions(
  filteredQuestions,
  gameId,
  anime,
  questionLimit,
  isMiscellaneous,
  getAnimeProgress,
  getMiscProgress
);

// The browser reselects this pool using the saved Troll Mode/progress state.
// Keep a renderable fallback for a pool containing only troll questions.
const sessionQuestions = selectedSessionQuestions.length
  ? selectedSessionQuestions
  : allQuestions.slice(0, questionLimit);
const totalQuestions = sessionQuestions.length;
const hasQuestions = allQuestions.length > 0;
---

<Layout title={`${animeName} - Description Game - Anime Realm`}>
  <main class="flex-grow min-h-screen">
    <!-- Game Header -->
    <header class="sticky top-16 z-30 border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 py-3 backdrop-blur-md md:py-4">
          <div class="section-container flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div class="flex min-w-0 items-center gap-3">
          <a href="/games/description" class="p-2 rounded-lg text-[var(--color-text-muted)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:text-[var(--color-text)] hover:bg-[var(--color-bg)] hover:bg-[var(--color-bg)] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)]" aria-label="Back to Description Game">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
          </a>
          <div class="min-w-0">
            <h1 class="text-xl md:text-2xl font-black gradient-text">{animeName}</h1>
            <p class="text-sm text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Description Game • <span id="session-question-count">{totalQuestions}</span> question<span id="session-question-plural">{totalQuestions !== 1 ? 's' : ''}</span></p>
          </div>
        </div>
        
        <div class="flex items-center gap-3">
          <!-- Progress Indicator -->
          <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--color-bg)] bg-[var(--color-border)] text-sm font-medium text-[var(--color-text-muted)] text-[var(--color-text-muted)]">
            <span id="question-counter">1 / {totalQuestions}</span>
          </div>
        </div>
      </div>
    </header>

    {hasQuestions ? (
      <>
        <!-- Game Area -->
        <section class="py-8 md:py-12" aria-label="Game Area">
          <div class="section-container max-w-3xl min-w-0">
            <!-- Question Card -->
            <article id="question-card" class="card relative !p-4 sm:!p-6 md:!p-8" data-question-index="0" role="region" aria-label="Question 1 of {totalQuestions}">
              <div class="absolute top-4 right-4 flex gap-2" aria-hidden="true">
                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-[var(--color-accent-lavender)] bg-[var(--color-primary)]/20 text-[var(--color-primary)] text-[var(--color-accent-lavender)]">
                  Q<span id="current-q-num">1</span>
                </span>
              </div>
              
              <!-- Front: Descriptions -->
              <div id="card-front">
                <div class="mb-6">
                  <h2 class="text-lg font-semibold text-[var(--color-text-muted)] text-[var(--color-text-muted)] mb-4">Clues</h2>
                  <div id="descriptions-container" class="space-y-3" role="list" aria-label="Progressive clues">
                    {sessionQuestions[0]?.descriptions?.map((description: string, index: number) => (
                      <div class:list={['clue-line', 'flex items-start gap-2.5 p-2.5 sm:gap-3 sm:p-3 rounded-lg', index === 0 ? 'bg-[var(--color-accent-lavender)]/30 border border-[var(--color-primary)]/20' : 'hidden']} role="listitem">
                        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[var(--color-primary)] text-white text-xs font-bold flex items-center justify-center">{index + 1}</span>
                        <span class="text-[var(--color-text)] leading-relaxed">{description}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <!-- Answer Input -->
                <div class="space-y-4">
                  <label for="answer-input" class="block text-sm font-semibold text-[var(--color-text)] text-[var(--color-text)]">
                    Your Answer
                  </label>
                  <div class="relative">
                    <input
                      type="text"
                      id="answer-input"
                      class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-text)] placeholder-[var(--color-text-muted)] caret-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all text-lg pr-24"
                      placeholder="Type the character name..."
                      autocomplete="off"
                      spellcheck="false"
                      aria-describedby="answer-hint"
                    />
                    <button
                      type="button"
                      id="submit-answer"
                      class="absolute right-3 top-1/2 -translate-y-1/2 px-4 py-2 rounded-lg bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-secondary)] text-white font-semibold text-sm hover:from-[var(--color-primary-dark)] hover:to-[var(--color-secondary-dark)] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2"
                      aria-label="Submit answer"
                    >
                      Submit
                    </button>
                  </div>
                  <p id="answer-hint" class="text-xs text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Press Enter to submit</p>
                </div>
                
                <!-- Feedback -->
                <div id="feedback" class="hidden mt-4 p-4 rounded-lg" role="alert" aria-live="polite"></div>
              </div>
              
              <!-- Back: reveal correct guesses, keep incorrect answers hidden -->
              <div id="card-back" class="absolute inset-0 p-4 sm:p-6 md:p-8 hidden flex-col items-center justify-center text-center cursor-pointer">
                <div class="relative w-full max-w-md">
                  <div class="absolute top-4 right-4 px-3 py-1 rounded-full bg-green-500/90 text-white font-bold text-sm shadow-lg" id="question-score">
                    +<span id="earned-score">1.0</span>
                  </div>
                  <div id="reveal-image" class="relative hidden aspect-square overflow-hidden rounded-xl bg-[var(--color-bg)] bg-[var(--color-border)]" style={`background-image: url('${sessionQuestions[0].image}'); background-size: cover; background-position: center;`}>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" aria-hidden="true"></div>
                    <h3 id="revealed-name" class="absolute bottom-4 left-4 right-4 text-left text-2xl font-bold text-white drop-shadow-lg"></h3>
                  </div>
                  <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6 sm:p-12">
                    <p id="result-status" class="text-2xl md:text-3xl font-bold text-[var(--color-text)]">Correct</p>
                    <p class="mt-2 text-sm text-[var(--color-text-muted)]">Tap to return to the clues</p>
                  </div>
                  <div class="mt-4 flex justify-center gap-4">
                    <button
                      id="next-question-btn"
                      class="btn-primary hidden"
                      aria-label="Next question"
                    >
                      Next Question
                    </button>
                  </div>
                </div>
              </div>
            </article>

            <div id="runtime-no-questions" class="hidden card gradient-border text-center" role="status" aria-live="polite">
              <h2 class="text-2xl font-bold text-[var(--color-text)] mb-4">No Questions Available</h2>
              <p class="text-[var(--color-text-muted)] mb-6">No questions match the current Troll Mode. Return to Browse Games to change the global setting, or add matching questions.</p>
              <a href="/games/description" class="btn-secondary">Back to Game Select</a>
            </div>
            
            <!-- Score Summary (shown at end) -->
            <div id="score-summary" class="hidden mt-6 card gradient-border text-center">
              <h2 class="text-2xl font-bold text-[var(--color-text)] text-[var(--color-text)] mb-4">Session Complete!</h2>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
                <div class="p-4 rounded-xl bg-[var(--color-accent-lavender)]/50 bg-[var(--color-primary)]/20">
                  <div class="text-3xl font-bold gradient-text" id="final-correct">0</div>
                  <div class="text-sm text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Correct</div>
                </div>
                <div class="p-4 rounded-xl bg-red-100/50 bg-red-900/20">
                  <div class="text-3xl font-bold text-red-600 text-red-400" id="final-wrong">0</div>
                  <div class="text-sm text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Wrong</div>
                </div>
                <div class="p-4 rounded-xl bg-[var(--color-bg)] bg-[var(--color-border)]">
                  <div class="text-3xl font-bold gradient-text" id="final-percentage">0.0</div>
                <div class="text-sm text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Score Percentage</div>
                </div>
              </div>
              <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href={`/games/description/${anime}`} class="btn-secondary">Play Again</a>
                <a href="/leaderboard" class="btn-primary">View Leaderboard</a>
              </div>
            </div>
          </div>
        </section>
      </>
    ) : (
      // No questions available
      <section class="py-16 md:py-24">
        <div class="section-container max-w-md mx-auto text-center">
          <div class="card gradient-border !p-6 sm:!p-12">
            <div class="text-6xl mb-4" aria-hidden="true">😔</div>
            <h2 class="text-2xl font-bold text-[var(--color-text)] text-[var(--color-text)] mb-4">No Questions Available</h2>
            <p class="text-[var(--color-text-muted)] text-[var(--color-text-muted)] mb-6">
              No questions are available for {animeName} yet. Try a different anime or add matching questions.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="/games/description" class="btn-secondary">Back to Game Select</a>
            </div>
          </div>
        </div>
      </section>
    )}
  </main>
</Layout>

<script id="game-session-data" type="application/json" set:html={JSON.stringify({ initialQuestions: sessionQuestions, allQuestions, questionLimit, isMiscellaneous: isMiscellaneousStr, gameId, animeId: anime })}></script>

<script>
  import { getClientSessionQuestions, loadCurrentClientQuestions, saveClientSession } from '../../../utils/gameClient';
  import { getPrimaryAnswer, isAnswerInList } from '../../../utils/gameSession';

  const sessionData = document.getElementById('game-session-data')?.textContent;
  if (!sessionData) throw new Error('Missing game session data');
  const { initialQuestions, allQuestions, questionLimit, isMiscellaneous, gameId, animeId } = JSON.parse(sessionData);

  // Game state
  let sessionQuestions = initialQuestions;
  let currentQuestionIndex = 0;
  let correctCount = 0;
  let wrongCount = 0;
  let scores = [];
  let playedQuestionIds = [];
  let isFlipped = false;
  let currentLineIndex = 0;
  let questionAnswered = false;
  let totalQuestions = sessionQuestions.length;

  // DOM Elements
  const questionCard = document.getElementById('question-card');
  const cardFront = document.getElementById('card-front');
  const cardBack = document.getElementById('card-back');
  const answerInput = document.getElementById('answer-input');
  const submitBtn = document.getElementById('submit-answer');
  const feedback = document.getElementById('feedback');
  const descriptionsContainer = document.getElementById('descriptions-container');
  const questionCounter = document.getElementById('question-counter');
  const sessionQuestionCount = document.getElementById('session-question-count');
  const sessionQuestionPlural = document.getElementById('session-question-plural');
  const currentQNum = document.getElementById('current-q-num');
  const resultStatus = document.getElementById('result-status');
  const revealImage = document.getElementById('reveal-image');
  const revealedName = document.getElementById('revealed-name');
  const earnedScore = document.getElementById('earned-score');
  const questionScore = document.getElementById('question-score');
  const nextQuestionBtn = document.getElementById('next-question-btn');
  const scoreSummary = document.getElementById('score-summary');
  const finalCorrect = document.getElementById('final-correct');
  const finalWrong = document.getElementById('final-wrong');
  const finalPercentage = document.getElementById('final-percentage');
  const runtimeNoQuestions = document.getElementById('runtime-no-questions');

  async function applyClientSession(): Promise<boolean> {
    const currentQuestions = await loadCurrentClientQuestions(
      allQuestions,
      gameId,
      animeId,
      isMiscellaneous === 'true',
    );
    sessionQuestions = getClientSessionQuestions(
      currentQuestions,
      gameId,
      animeId,
      questionLimit,
      isMiscellaneous === 'true',
    );
    totalQuestions = sessionQuestions.length;
    if (sessionQuestionCount) sessionQuestionCount.textContent = String(totalQuestions);
    if (sessionQuestionPlural) sessionQuestionPlural.textContent = totalQuestions === 1 ? '' : 's';

    if (!sessionQuestions.length) {
      questionCard?.classList.add('hidden');
      runtimeNoQuestions?.classList.remove('hidden');
      return false;
    }

    questionCard?.classList.remove('hidden');
    runtimeNoQuestions?.classList.add('hidden');
    if (questionCounter) questionCounter.textContent = `1 / ${totalQuestions}`;
    if (currentQNum) currentQNum.textContent = '1';
    return true;
  }

  async function initializeGame() {
    if (!await applyClientSession()) return;

    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    window.scrollTo(0, 0);
    requestAnimationFrame(() => window.scrollTo(0, 0));

    // Render first question descriptions
    updateQuestionDisplay();

    // Event listeners
    submitBtn?.addEventListener('click', submitAnswer);
    answerInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        submitAnswer();
      }
    });

    nextQuestionBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      nextQuestion();
    });

    // Toggle the card face on click/tap, but only once the question is answered
    questionCard?.addEventListener('click', () => {
      if (!questionAnswered) return;
      flipCard(!isFlipped);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeGame, { once: true });
  } else {
    initializeGame();
  }

  function getCurrentQuestion() {
    return sessionQuestions[currentQuestionIndex];
  }

  function renderDescriptions() {
    const q = getCurrentQuestion();
    if (!q || !descriptionsContainer) return;

    descriptionsContainer.innerHTML = '';
    const descriptions = Array.isArray(q.descriptions) ? q.descriptions : [];
    descriptions.forEach((desc, idx) => {
      const isVisible = idx === 0 || idx <= currentLineIndex;
      const line = document.createElement('div');
      line.className = `description-line p-4 rounded-lg bg-[var(--color-bg)] bg-[var(--color-border)] border border-[var(--color-border)] transition-all duration-300 ${isVisible ? '' : 'hidden opacity-0'}`;
      line.dataset.lineIndex = String(idx);
      line.setAttribute('role', 'listitem');
      line.setAttribute('aria-hidden', idx > currentLineIndex ? 'true' : 'false');
      line.innerHTML = `
        <div class="flex min-w-0 items-start gap-2.5 sm:gap-3">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-secondary)] flex items-center justify-center text-white text-sm font-bold" aria-hidden="true">${idx + 1}</span>
          <p class="min-w-0 flex-1 text-[var(--color-text)] text-[var(--color-text)] leading-relaxed">${desc}</p>
        </div>
      `;
      descriptionsContainer.appendChild(line);
    });
  }

  function updateQuestionDisplay() {
    const q = getCurrentQuestion();
    if (!q) return;

    // Update question counter
    questionCounter.textContent = `${currentQuestionIndex + 1} / ${totalQuestions}`;
    currentQNum.textContent = String(currentQuestionIndex + 1);

    // Re-render descriptions for the current question
    renderDescriptions();

    // Reset input
    answerInput.value = '';
    answerInput.disabled = false;
    submitBtn.disabled = false;
    feedback.classList.add('hidden');
    feedback.textContent = '';
    feedback.className = 'hidden mt-4 p-4 rounded-lg';

    resultStatus.textContent = 'Correct';
    resultStatus.className = 'text-2xl md:text-3xl font-bold text-green-300';
    revealImage?.classList.add('hidden');

    // Reset flipped state and visibility
    questionAnswered = false;
    nextQuestionBtn?.classList.add('hidden');
    flipCard(false);
  }

  function submitAnswer() {
    if (questionAnswered) return;

    const answer = answerInput.value.trim();
    if (!answer) return;

    const question = getCurrentQuestion();
    const isCorrect = isAnswerInList(answer, question.answer);

    if (isCorrect) {
      // Correct answer - reveal all remaining lines, flip card
      const earnedPoints = calculateDescriptionScore(currentLineIndex);
      correctCount++;
      scores.push(earnedPoints);
      playedQuestionIds.push(question.id);
      questionAnswered = true;

      showFeedback(`Correct! 🎉 Score: ${earnedPoints.toFixed(1)} point${earnedPoints === 1 ? '' : 's'}`, 'success');
      revealAllLines();

      // Update score display on card back
      if (earnedScore) earnedScore.textContent = earnedPoints.toFixed(1);
      if (questionScore) {
        questionScore.className = 'absolute top-4 right-4 px-3 py-1 rounded-full bg-green-500/90 text-white font-bold text-sm shadow-lg';
      }
      resultStatus.textContent = 'Correct';
      resultStatus.className = 'text-2xl md:text-3xl font-bold text-green-300';
      if (revealImage && question.image) {
        revealImage.style.backgroundImage = `url('${question.image}')`;
        revealImage.classList.remove('hidden');
      }
      if (revealedName) revealedName.textContent = getPrimaryAnswer(question.answer);

      // Disable input after correct answer
      answerInput.disabled = true;
      submitBtn.disabled = true;

      nextQuestionBtn?.classList.remove('hidden');
      setTimeout(() => flipCard(true), 800);
    } else {
      // Wrong answer - reveal next line
      if (currentLineIndex < question.descriptions.length - 1) {
        currentLineIndex++;
        updateQuestionDisplay();
        showFeedback('Not quite! Next clue revealed.', 'error');
        answerInput.value = '';
      } else {
        // Wrong on last line - game over for this question
        wrongCount++;
        scores.push(0);
        playedQuestionIds.push(question.id);
        questionAnswered = true;

        showFeedback('Wrong! Score: 0 points.', 'error');
        revealAllLines();

        // Update score display on card back (0 points)
        if (earnedScore) earnedScore.textContent = '0';
        if (questionScore) {
          questionScore.className = 'absolute top-4 right-4 px-3 py-1 rounded-full bg-red-500/90 text-white font-bold text-sm shadow-lg';
        }
        resultStatus.textContent = 'Wrong';
        resultStatus.className = 'text-2xl md:text-3xl font-bold text-red-300';
        revealImage?.classList.add('hidden');

        // Disable input
        answerInput.disabled = true;
        submitBtn.disabled = true;

        nextQuestionBtn?.classList.remove('hidden');
        setTimeout(() => flipCard(true), 1500);
      }
    }
  }

  function calculateDescriptionScore(lineIndex) {
    const scores = [1.0, 0.8, 0.6, 0.4, 0.2];
    return scores[lineIndex] || 0;
  }

  function revealAllLines() {
    const q = getCurrentQuestion();
    if (!q) return;
    currentLineIndex = q.descriptions.length - 1;
    renderDescriptions();
  }

  function flipCard(showBack) {
    isFlipped = showBack;

    if (showBack) {
      // Render the back before rotating so it is visible as the card turns
      cardBack?.classList.remove('hidden');
      cardBack?.classList.add('flex');
    } else {
      // Keep the front in normal flow so the card keeps its height when flipped
      cardFront?.classList.remove('hidden');
    }

    questionCard?.classList.toggle('flipped', showBack);

    if (!showBack) {
      setTimeout(() => {
        cardBack?.classList.add('hidden');
        cardBack?.classList.remove('flex');
      }, 300);
    }
  }

  function nextQuestion() {
    flipCard(false);
    currentQuestionIndex++;
    currentLineIndex = 0;
    
    if (currentQuestionIndex >= totalQuestions) {
      // Game over
      endGame();
    } else {
      // Next question
      updateQuestionDisplay();
    }
  }

  function endGame() {
    questionCard?.classList.add('hidden');
    scoreSummary?.classList.remove('hidden');

    const totalScore = scores.reduce((a, b) => a + b, 0);
    const averageScore = totalQuestions > 0 ? totalScore / totalQuestions : 0;
    const percentage = Math.round(averageScore * 100);

    finalCorrect.textContent = String(correctCount);
    finalWrong.textContent = String(wrongCount);
    finalPercentage.textContent = `${percentage}%`;

    // Save progress and result
    saveProgressAndResult(percentage, averageScore);
  }

  function saveProgressAndResult(percentage, averageScore) {
    saveClientSession(
      gameId,
      animeId,
      isMiscellaneous === 'true',
      playedQuestionIds,
      averageScore,
      percentage,
    ).catch((error) => console.error('Failed to save game session:', error));
  }

  function showFeedback(message, type) {
    feedback.textContent = message;
    feedback.className = `mt-4 p-4 rounded-lg ${type === 'success'
      ? 'bg-green-100 bg-green-900/30 text-green-800 text-green-300 border border-green-300 border-green-700'
      : 'bg-red-100 bg-red-900/30 text-red-800 text-red-300 border border-red-300 border-red-700'}`;
    feedback.classList.remove('hidden');
  }
</script>

<style>
  .description-line {
    animation: slideIn 0.3s ease-out forwards;
  }

  @keyframes slideIn {
    from { opacity: 0; transform: translateX(-10px); }
    to { opacity: 1; transform: translateX(0); }
  }

  /* Card flip styles */
  #question-card {
    transition: transform 0.6s;
    transform-style: preserve-3d;
    cursor: pointer;
  }

  #question-card.flipped {
    transform: rotateY(180deg);
  }

  #card-front,
  #card-back {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  #card-back {
    transform: rotateY(180deg);
  }
</style>
