---
// Leaderboard page
import Layout from '../layouts/Layout.astro';
import gamescategory from '../../database/gamescategory.json';

const legacyGameCategories = [
  { id: 'Combined', name: 'Combined', icon: '🏆' },
  ...gamescategory.filter(g => g.show).map(g => ({ id: g.id, name: g.name, icon: g.id === 'description' ? '📝' : g.id === 'zoomed' ? '🔍' : '🎨' }))
];

const gameCategories = [
  { id: 'Combined', name: 'Combined', icon: String.fromCodePoint(0x1F3C6) },
  { id: 'Description', name: 'Description Game', icon: String.fromCodePoint(0x1F4DD) },
  { id: 'Colour', name: 'Colour Guessing Game', icon: String.fromCodePoint(0x1F3A8) },
  { id: 'Zoom', name: 'Zoomed Image Game', icon: String.fromCodePoint(0x1F50D) },
];
---

<Layout title="Global Leaderboard - Anime Realm">
  <main class="flex-grow min-h-screen">
    <!-- Page Header -->
    <header class="py-16 md:py-24 bg-gradient-to-br from-[var(--color-accent-lavender)]/50 to-[var(--color-accent-red)]/50 from-[var(--color-primary)]/10 to-[var(--color-secondary)]/10">
      <div class="section-container text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight gradient-text mb-6">Global Leaderboard</h1>
        <p class="text-lg md:text-xl text-[var(--color-text-muted)] text-[var(--color-text-muted)] max-w-2xl mx-auto leading-relaxed">
          The best anime quiz masters. Climb the ranks and prove your knowledge!
        </p>
      </div>
    </header>

    <!-- Leaderboard Content -->
    <section class="py-16 md:py-24">
      <div class="section-container">
        <!-- Category Filter Dropdown -->
        <div class="mb-8 md:mb-12 flex justify-center">
          <div class="relative w-full max-w-xs">
            <select
              id="category-select"
              class="w-full px-6 py-3 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] text-white font-semibold appearance-none cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] focus-visible:ring-offset-2 pr-10"
            >
              {gameCategories.map((cat) => (
                <option value={cat.id}>
                  {cat.icon} {cat.name}
                </option>
              ))}
            </select>
            <svg class="absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5 text-[var(--color-text-muted)] pointer-events-none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </div>
        </div>
        
        <!-- Leaderboard Panels -->
        <div class="space-y-6" role="tabpanel">
          {gameCategories.map((cat, index) => (
            <div 
              id={`leaderboard-${cat.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${cat.id}`}
              class={`leaderboard-panel ${index !== 0 ? 'hidden' : ''}`}
            >
              <div id={`leaderboard-content-${cat.id}`} class="card overflow-hidden">
                <div class="overflow-x-auto rounded-xl border border-[var(--color-border)]">
                  <table class="w-full" role="table" aria-label={`${cat.name} leaderboard`}>
                    <thead>
                      <tr class="bg-[var(--color-bg)] bg-[var(--color-border)] border-b border-[var(--color-border)] border-[var(--color-border)]">
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Rank</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Player</th>
                        <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Player ID</th>
                        <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Percentage</th>
                      </tr>
                    </thead>
                    <tbody id={`leaderboard-body-${cat.id}`} class="divide-y divide-[var(--color-border)] divide-[var(--color-border)]">
                      <tr>
                        <td colspan="4" class="px-4 py-12 text-center text-[var(--color-text-muted)] text-[var(--color-text-muted)]">
                          <div class="flex flex-col items-center gap-3">
                            <div class="w-8 h-8 border-4 border-[var(--color-primary)] border-t-transparent rounded-full animate-spin" aria-hidden="true"></div>
                            <span>Loading leaderboard...</span>
                          </div>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                
                <!-- Empty State -->
                <div id={`leaderboard-empty-${cat.id}`} class="hidden p-12 text-center">
                  <div class="text-6xl mb-4" aria-hidden="true">🏆</div>
                  <h3 class="text-xl font-bold text-[var(--color-text)] text-[var(--color-text)] mb-2">No Scores Yet</h3>
                  <p class="text-[var(--color-text-muted)] text-[var(--color-text-muted)]">Be the first to play and set a record!</p>
                  <a href="/games" class="btn-primary mt-6 inline-block">Play Now</a>
                </div>
              </div>
            </div>
          ))}
        </div>
        
        <!-- Legend / Info -->
        <div class="mt-8 md:mt-12 card gradient-border">
          <h3 class="text-lg font-bold text-[var(--color-text)] text-[var(--color-text)] mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-[var(--color-primary)]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
            </svg>
            How Scoring Works
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm text-[var(--color-text-muted)] text-[var(--color-text-muted)]">
            <div class="p-4 rounded-lg bg-[var(--color-bg)] bg-[var(--color-border)]">
              <h4 class="font-semibold text-[var(--color-text)] text-[var(--color-text)] mb-2 flex items-center gap-2">
                <span class="text-[var(--color-primary)]">📝</span> Description Game
              </h4>
              <p>Progressive clues. Earlier correct answers score higher (1.0 → 0.2). Wrong answers reveal next clue.</p>
            </div>
            <div class="p-4 rounded-lg bg-[var(--color-bg)] bg-[var(--color-border)]">
              <h4 class="font-semibold text-[var(--color-text)] text-[var(--color-text)] mb-2 flex items-center gap-2">
                <span class="text-[var(--color-primary)]">🔍</span> Zoomed Image Game
              </h4>
              <p>Identify from zoomed image. 1 point for correct, 0 for wrong. Image zooms out on answer.</p>
            </div>
            <div class="p-4 rounded-lg bg-[var(--color-bg)] bg-[var(--color-border)]">
              <h4 class="font-semibold text-[var(--color-text)] text-[var(--color-text)] mb-2 flex items-center gap-2">
                <span class="text-[var(--color-primary)]">🎨</span> Colour Guessing Game
              </h4>
              <p>Match color percentage (0-100%). Score = match% ÷ 100. Hold to compare with correct answer.</p>
            </div>
            <div class="md:col-span-3 p-4 rounded-lg bg-gradient-to-r from-[var(--color-primary)]/10 to-[var(--color-secondary)]/10 border border-[var(--color-primary)]/20 border-[var(--color-secondary)]/20">
              <h4 class="font-semibold text-[var(--color-text)] text-[var(--color-text)] mb-2 flex items-center gap-2">
                <span class="text-[var(--color-primary)]">🏆</span> Combined Score
              </h4>
              <p>Average of your best scores across all three game categories. Each category contributes equally regardless of anime played.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { getGoogleLeaderboards, type GoogleLeaderboards } from '../utils/api';

  // Leaderboard state
  let currentCategory = 'Combined';
  let leaderboards: GoogleLeaderboards | null = null;
  let leaderboardLoad: Promise<GoogleLeaderboards> | null = null;
  let leaderboardError = false;
  const apiCategoryByDropdown: Record<string, keyof GoogleLeaderboards> = {
    Combined: 'Combined',
    Description: 'Description',
    Colour: 'Colour',
    Zoom: 'Zoom',
  };
  const categorySelect = document.getElementById('category-select') as HTMLSelectElement;
  const leaderboardPanels = document.querySelectorAll('.leaderboard-panel');

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    loadLeaderboard('Combined');

    // Dropdown change handler
    if (categorySelect) {
      categorySelect.addEventListener('change', () => {
        const category = categorySelect.value;
        if (category && category !== currentCategory) {
          switchCategory(category);
        }
      });
    }
  });

  async function switchCategory(category: string) {
    currentCategory = category;

    // Update dropdown
    if (categorySelect) {
      categorySelect.value = category;
    }

    // Update panels
    leaderboardPanels.forEach(panel => {
      const isActive = panel.id === `leaderboard-${category}`;
      if (isActive) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });

    // All categories were fetched on page load; switching only re-renders local data.
    renderLeaderboard(category);
  }

  async function loadLeaderboard(category: string, fetchIfMissing = true) {
    const tbody = document.getElementById(`leaderboard-body-${category}`);
    const emptyState = document.getElementById(`leaderboard-empty-${category}`);
    const content = document.getElementById(`leaderboard-content-${category}`);

    if (!tbody) return;

    // Show loading
    tbody.innerHTML = `
      <tr>
        <td colspan="4" class="px-4 py-12 text-center text-[var(--color-text-muted)] text-[var(--color-text-muted)]">
          <div class="flex flex-col items-center gap-3">
            <div class="w-8 h-8 border-4 border-[var(--color-primary)] border-t-transparent rounded-full animate-spin" aria-hidden="true"></div>
            <span>Loading leaderboard...</span>
          </div>
        </td>
      </tr>
    `;
    emptyState?.classList.add('hidden');
    content?.classList.remove('hidden');

    try {
      // The complete Google Sheets response is requested once per page load.
      if (!leaderboards) {
        if (!fetchIfMissing) {
          if (leaderboardError) showLeaderboardError(category);
          return;
        }
        leaderboardLoad ??= getGoogleLeaderboards();
        leaderboards = await leaderboardLoad;
      }
      const apiCategory = apiCategoryByDropdown[category];
      const entries = apiCategory ? leaderboards[apiCategory] : [];

      if (entries.length === 0) {
        content?.classList.add('hidden');
        emptyState?.classList.remove('hidden');
        return;
      }

      // Render leaderboard
      tbody.innerHTML = entries.map((entry) => {
      const rank = entry.rank;
      const rankIcon = rank === 1 ? '🥇' : rank === 2 ? '🥈' : rank === 3 ? '🥉' : '#';
      const rowTone = rank === 1
        ? { row: 'bg-amber-300/40', light: 'bg-yellow-200', text: 'text-amber-950', name: 'text-amber-100', shadow: 'shadow-amber-200/50' }
        : rank === 2
          ? { row: 'bg-slate-500/90', light: 'bg-slate-200', text: 'text-slate-900', name: 'text-slate-100', shadow: 'shadow-slate-200/50' }
          : rank === 3
            ? { row: 'bg-orange-700/60', light: 'bg-orange-200', text: 'text-orange-950', name: 'text-orange-100', shadow: 'shadow-orange-200/50' }
            : rank <= 10
              ? { row: 'bg-blue-600/40', light: 'bg-blue-200', text: 'text-blue-950', name: 'text-blue-100', shadow: 'shadow-blue-200/50' }
              : { row: 'bg-slate-800/50', light: 'bg-zinc-200', text: 'text-zinc-950', name: 'text-zinc-100', shadow: 'shadow-zinc-200/50' };
      const rankLabel = rank <= 3 ? `${rankIcon} ${rank}` : `#${rank}`;

      return `
          <tr class="transition-[filter] hover:brightness-125 ${rowTone.row}">
            <td class="px-4 py-4">
              <span class="inline-flex h-10 min-w-10 items-center justify-center rounded-full px-2 font-black ${rowTone.light} ${rowTone.text} shadow-lg ${rowTone.shadow}">${rankLabel}</span>
            </td>
            <td class="px-4 py-4 font-bold ${rowTone.name}">${escapeHtml(entry.playerName)}</td>
            <td class="px-4 py-4 font-bold ${rowTone.name}">${escapeHtml(entry.playerId)}</td>
            <td class="px-4 py-4 text-right">
              <span class="inline-flex rounded-full px-3 py-1 font-black ${rowTone.light} ${rowTone.text}">${entry.percentage}%</span>
            </td>
          </tr>
        `;
      }).join('');

    } catch (error) {
      console.error('Failed to load leaderboard:', error);
      leaderboardLoad = null;
      leaderboardError = true;
      showLeaderboardError(category);
    }
  }

  function showLeaderboardError(category: string) {
    const tbody = document.getElementById(`leaderboard-body-${category}`);
    if (!tbody) return;

    tbody.innerHTML = `
        <tr>
          <td colspan="4" class="px-4 py-12 text-center text-red-500">
            <div class="flex flex-col items-center gap-3">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
              </svg>
              <span>Failed to load leaderboard. Please try again.</span>
              <button onclick="loadLeaderboard('${category}')" class="btn-secondary text-sm">Retry</button>
            </div>
          </td>
        </tr>
      `;
  }

  function renderLeaderboard(category: string) {
    // Dropdown changes only render the cached response; they never fetch.
    loadLeaderboard(category, false);
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // Make loadLeaderboard globally accessible for retry button
  (window as any).loadLeaderboard = loadLeaderboard;
</script>

<style>
  .tab-btn:focus-visible {
    outline: none;
    ring: 2px;
    ring-offset: 2px;
  }
  
  /* Smooth panel transitions */
  .leaderboard-panel {
    animation: fadeIn 0.3s ease-out;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  /* Table responsiveness */
  @media (max-width: 640px) {
    .overflow-x-auto table {
      min-width: 500px;
    }
  }
</style>
