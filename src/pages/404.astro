---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found - Otaku Blitz">
  <main class="flex flex-grow items-center py-16 md:py-24">
    <section class="section-container w-full text-center">
      <div class="mx-auto max-w-xl card gradient-border">
        <p class="gradient-text text-7xl font-black md:text-8xl">404</p>
        <h1 class="mt-4 text-3xl font-black text-[var(--color-text)] md:text-4xl">This quest went off-route.</h1>
        <p class="mt-4">The page you are looking for does not exist, may have moved, or is hiding in another anime universe.</p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a class="btn-primary" href="/">Return Home</a>
          <a class="btn-secondary" href="/games">Browse Games</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
