---
const inputId = 'troll-mode';
---

<label class="inline-flex min-h-11 cursor-pointer items-center gap-3 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-sm font-medium text-[var(--color-text)]" for={inputId}>
  <input
    id={inputId}
    type="checkbox"
    class="peer sr-only"
    data-troll-mode
    aria-label="Enable Troll Mode for all games"
  />
  <span class="relative h-5 w-10 rounded-full bg-[var(--color-border)] transition-colors peer-checked:bg-[var(--color-primary)] peer-focus-visible:ring-2 peer-focus-visible:ring-[var(--color-primary)] peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-[var(--color-bg)] after:absolute after:left-0.5 after:top-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-transform after:content-[''] peer-checked:after:translate-x-5" aria-hidden="true"></span>
  <span>Troll Mode</span>
</label>

<script>
  const toggle = document.querySelector<HTMLInputElement>('[data-troll-mode]');

  if (toggle) {
    toggle.checked = localStorage.getItem('animegames_trollmode') === 'true';
    toggle.addEventListener('change', () => {
      localStorage.setItem('animegames_trollmode', String(toggle.checked));
    });
  }
</script>
