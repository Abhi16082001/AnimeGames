---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PlayerRegistration from '../components/PlayerRegistration.astro';

interface Props {
	title?: string;
}

const { title = "Anime Realm 🎮 - Dynamic Anime Games Playground" } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#0a0a0f" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-[var(--color-bg)] text-[var(--color-text)]">
		<!-- Header/Navbar -->
		<Header />

		<!-- Main Page Content -->
		<slot />

		<!-- Footer -->
		<Footer />

		<!-- Player Identity Registration Modal -->
		{Astro.url.pathname.split('/').filter(Boolean).length >= 3 && <PlayerRegistration />}
	</body>
</html>
